{
  "expo": {
    "name": "AHTRI FFA",
    "slug": "ahtri-ffa-mobile",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B2545"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ahtri.ffa"
    },
    "android": {
      "package": "com.ahtri.ffa",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B2545"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "shortName": "AHTRI FFA",
      "name": "AHTRI Field Force Automation",
      "description": "AHTRI Pharma Field Force Automation Mobile App",
      "backgroundColor": "#0B2545",
      "themeColor": "#0B2545",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AHTRI FFA to verify your current location for task geofencing and attendance punch-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AHTRI FFA to attach photos of clinic visits and expense bills."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "60909a48-8c02-4b10-ba38-404119640394"
      }
    },
    "owner": "shiva900"
  }
}